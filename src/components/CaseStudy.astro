---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCover from './WorkCover.astro';
import LangSwitch from './LangSwitch.astro';
import type { Lang } from '../i18n/ui';
import { localise, useTranslations } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'work'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const { Content } = await render(entry);

const contextLabel = {
  coursework: t('context.coursework'),
  team: t('context.team'),
  personal: t('context.personal'),
  competition: t('context.competition'),
} as const;

const backHref = localise('/#work', lang);
---

<Base title={d.title} description={d.tagline}>
  <article class="field field-paper bg-paper text-paper-ink">
    <header class="border-b border-paper-2">
      <div class="px-6 pt-10">
        <div class="mx-auto flex max-w-5xl items-center justify-between">
          <a href={backHref} class="label text-paper-muted hover:text-accent">
            ← {t('work.allWork')}
          </a>
          <LangSwitch tone="paper" />
        </div>
      </div>

      <div class="px-6 pt-12 pb-14">
        <div class="mx-auto max-w-5xl">
          <h1 class="clip-reveal text-4xl font-medium tracking-tight sm:text-6xl">{d.title}</h1>
          <p class="mt-5 max-w-2xl text-xl leading-snug text-paper-ink/80">{d.tagline}</p>

          <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-start">
            <div class="group relative overflow-hidden border border-paper-2">
              <WorkCover entry={entry} width={1100} ratio="16 / 10" glyphDensity={9} />
              {
                !d.cover && (
                  <span
                    class:list={[
                      'absolute right-4 bottom-4 max-w-[18rem] text-right font-mono text-[0.625rem] leading-snug',
                      d.backdrop ? 'text-paper/70' : 'text-paper-muted/60',
                    ]}
                  >
                    {t('work.noShot')}
                  </span>
                )
              }
            </div>

            <div>
              <dl class="grid grid-cols-2 gap-y-6 border-y border-paper-2 py-6">
                <div>
                  <dt class="label text-paper-muted">{t('work.role')}</dt>
                  <dd class="mt-1.5 text-[0.9375rem]">{d.role}</dd>
                </div>
                <div>
                  <dt class="label text-paper-muted">{t('work.year')}</dt>
                  <dd class="mt-1.5 font-mono text-[0.9375rem]">{d.year}</dd>
                </div>
                <div>
                  <dt class="label text-paper-muted">{t('work.context')}</dt>
                  <dd class="mt-1.5 text-[0.9375rem]">{contextLabel[d.context]}</dd>
                </div>
              </dl>

              {
                d.facts && (
                  <dl class="mt-6 grid grid-cols-3 gap-4">
                    {d.facts.map((f) => (
                      <div>
                        <dd class="font-mono text-3xl leading-none">{f.value}</dd>
                        <dt class="label mt-2 text-paper-muted">{f.label}</dt>
                      </div>
                    ))}
                  </dl>
                )
              }

              <ul class="mt-7 flex flex-wrap gap-1.5">
                {
                  d.stack.map((s) => (
                    <li class="border border-paper-2 px-2.5 py-1 font-mono text-xs text-paper-muted">
                      {s}
                    </li>
                  ))
                }
              </ul>

              <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm">
                {
                  d.repo && (
                    <a href={d.repo} class="border-b border-accent pb-0.5 hover:text-accent">
                      {t('work.sourceCode')}
                    </a>
                  )
                }
                {
                  d.live && d.liveStatus === 'up' && (
                    <a href={d.live} class="border-b border-accent pb-0.5 hover:text-accent">
                      {t('work.live')}
                    </a>
                  )
                }
                {
                  d.liveStatus === 'down' && (
                    <span class="text-paper-muted/70">
                      {t('work.offline')} — {d.liveNote?.toLowerCase()}
                    </span>
                  )
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="relative px-6 py-16">
      <div class="prose mx-auto max-w-3xl">
        <Content />
      </div>
    </div>

    {
      d.gallery && (
        <div class="border-t border-paper-2 px-6 py-16">
          <div class="mx-auto grid max-w-5xl gap-6">
            {d.gallery.map((shot) => (
              <figure class="reveal">
                <div class="overflow-hidden border border-paper-2 bg-paper-2/40">
                  <Image
                    src={shot.src}
                    alt={shot.alt}
                    width={1100}
                    densities={[1, 2]}
                    loading="lazy"
                    decoding="async"
                    class="w-full"
                  />
                </div>
                <figcaption class="mt-3 font-mono text-xs text-paper-muted">{shot.alt}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )
    }

    <footer class="border-t border-paper-2 px-6 py-12">
      <div class="mx-auto max-w-5xl">
        <a href={backHref} class="label text-paper-muted hover:text-accent">
          ← {t('work.allWork')}
        </a>
      </div>
    </footer>
  </article>
</Base>

<style>
  .prose :global(h2) {
    margin-top: 3.5rem;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h2 + p) {
    margin-top: 1.25rem;
  }

  .prose :global(p) {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-paper-ink) 85%, transparent);
  }

  .prose :global(strong) {
    font-weight: 500;
    color: var(--color-paper-ink);
  }

  .prose :global(ul) {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .prose :global(li) {
    padding-left: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-paper-ink) 85%, transparent);
    position: relative;
  }

  .prose :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.75rem;
    height: 1px;
    background: var(--color-accent);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-paper-2);
    padding: 0.1em 0.35em;
  }

  .prose :global(a) {
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.05em;
  }

  .prose :global(a:hover) {
    color: var(--color-accent);
  }
</style>
