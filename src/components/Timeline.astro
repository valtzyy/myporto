---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { entryLang, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = (await getCollection('experience'))
  .filter((entry) => entryLang(entry.id) === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<ol class="relative">
  <!-- The spine every entry hangs off. -->
  <span class="absolute top-2 bottom-2 left-0 w-px bg-paper-2" aria-hidden="true"></span>

  {
    entries.map((entry, i) => {
      const { role, org, orgNote, period, kind, highlights } = entry.data;
      const isTechnical = kind === 'technical';

      return (
        <li class="reveal relative py-9 pl-8 sm:pl-12" style={`--i:${i}`}>
          <span
            class:list={[
              'absolute top-11 -left-[5px] h-2.5 w-2.5 rounded-full',
              isTechnical ? 'bg-accent' : 'bg-paper-2 ring-1 ring-paper-muted/40',
            ]}
            aria-hidden="true"
          />

          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-paper-muted/70">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span
              class:list={[
                'label',
                isTechnical ? 'text-accent' : 'text-paper-muted/70',
              ]}
            >
              {isTechnical ? t('kind.technical') : t('kind.organisational')}
            </span>
            <span class="h-px flex-1 bg-paper-2" />
            {period && <span class="label text-paper-muted">{period}</span>}
          </div>

          <h3 class="mt-4 text-xl font-medium tracking-tight sm:text-2xl">{role}</h3>

          <p class="mt-1.5 text-paper-muted">
            {org}
            {orgNote && <span class="text-paper-muted/70"> — {orgNote}</span>}
          </p>

          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {highlights.map((line) => (
              <li class="flex gap-3 border-t border-paper-2 pt-3 text-[0.9375rem] leading-relaxed text-paper-ink/80">
                <span
                  class:list={[
                    'mt-2.5 h-px w-3 shrink-0',
                    isTechnical ? 'bg-accent' : 'bg-paper-muted/50',
                  ]}
                />
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </li>
      );
    })
  }
</ol>
