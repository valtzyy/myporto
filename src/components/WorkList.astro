---
import { getCollection } from 'astro:content';
import WorkCover from './WorkCover.astro';
import type { Lang } from '../i18n/ui';
import { entryLang, entrySlug, localise, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const all = (await getCollection('work'))
  .filter((entry) => entryLang(entry.id) === lang)
  .sort((a, b) => a.data.order - b.data.order);

const studies = all.filter((e) => e.data.format === 'case-study');
const cards = all.filter((e) => e.data.format === 'card');

const contextLabel = {
  coursework: t('context.coursework'),
  team: t('context.team'),
  personal: t('context.personal'),
  competition: t('context.competition'),
} as const;
---

<div class="space-y-4">
  {
    studies.map((entry, i) => {
      const d = entry.data;
      const flip = i % 2 === 1;

      return (
        <article class="field field-paper group reveal border border-paper-2 bg-paper/50 transition-colors duration-500 hover:border-paper-ink/25">
          <span class="absolute top-0 left-0 z-10 h-px w-0 bg-accent transition-all duration-700 group-hover:w-full" />

          <div class="relative grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
            <div
              class:list={[
                'relative border-paper-2',
                flip ? 'lg:order-2 lg:border-l' : 'lg:border-r',
              ]}
            >
              <WorkCover entry={entry} width={860} ratio="16 / 11" />

              <span class="absolute top-4 left-4 bg-paper/85 px-2 py-1 font-mono text-xs text-paper-muted backdrop-blur-sm">
                {String(i + 1).padStart(2, '0')}
              </span>

              {!d.cover && (
                <span
                  class:list={[
                    'absolute right-4 bottom-4 max-w-[16rem] text-right font-mono text-[0.625rem] leading-snug',
                    d.backdrop ? 'text-paper/70' : 'text-paper-muted/60',
                  ]}
                >
                  {t('work.noShot')}
                </span>
              )}
            </div>

            <div class="p-8 sm:p-11">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                <h3 class="text-2xl font-medium tracking-tight sm:text-3xl">{d.title}</h3>
                <span class="label text-paper-muted">
                  {d.year} · {contextLabel[d.context]}
                </span>
              </div>

              <p class="mt-4 text-lg leading-snug text-paper-ink/85">{d.tagline}</p>

              <p class="mt-5 flex items-center gap-2.5">
                <span class="h-px w-5 bg-accent" />
                <span class="label text-paper-ink">{d.role}</span>
              </p>

              {d.facts && (
                <dl class="mt-8 grid grid-cols-3 gap-4 border-y border-paper-2 py-5">
                  {d.facts.map((f) => (
                    <div>
                      <dd class="font-mono text-3xl leading-none">{f.value}</dd>
                      <dt class="label mt-2 text-paper-muted">{f.label}</dt>
                    </div>
                  ))}
                </dl>
              )}

              <ul class="mt-7 flex flex-wrap gap-1.5">
                {d.stack.map((s) => (
                  <li class="border border-paper-2 px-2.5 py-1 font-mono text-xs text-paper-muted">
                    {s}
                  </li>
                ))}
              </ul>

              <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3">
                <a
                  href={localise(`/work/${entrySlug(entry.id)}/`, lang)}
                  class="group/link inline-flex items-center gap-2 border-b border-accent pb-0.5 text-sm font-medium"
                >
                  {t('work.read')}
                  <span class="transition-transform duration-300 group-hover/link:translate-x-1">
                    →
                  </span>
                </a>

                {d.repo && (
                  <a href={d.repo} class="text-sm text-paper-muted hover:text-paper-ink">
                    {t('work.source')}
                  </a>
                )}

                {d.live && d.liveStatus === 'up' && (
                  <a href={d.live} class="text-sm text-paper-muted hover:text-paper-ink">
                    {t('work.live')}
                  </a>
                )}

                {d.liveStatus === 'down' && (
                  <span class="inline-flex items-center gap-2 text-sm text-paper-muted/70">
                    <span class="inline-block h-1.5 w-1.5 rounded-full bg-paper-muted/50" />
                    {t('work.offline')}
                  </span>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })
  }
</div>

<div class="mt-20">
  <h3 class="label text-paper-muted">{t('work.smaller')}</h3>

  <ul class="mt-6 grid gap-px border border-paper-2 bg-paper-2 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((entry) => {
        const d = entry.data;
        return (
          <li class="field field-paper group reveal flex flex-col bg-paper transition-colors duration-500 hover:bg-paper-2/40">
            <div class="relative border-b border-paper-2">
              <WorkCover entry={entry} width={520} ratio="16 / 10" glyphDensity={4} />
              {!d.cover && (
                <span
                  class:list={[
                    'absolute right-3 bottom-3 max-w-[85%] text-right font-mono text-[0.5625rem] leading-tight',
                    d.backdrop ? 'text-paper/70' : 'text-paper-muted/60',
                  ]}
                >
                  {t('work.noShot')}
                </span>
              )}
            </div>

            <div class="relative flex flex-1 flex-col p-6">
              <h4 class="font-medium tracking-tight">{d.title}</h4>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-paper-muted">{d.tagline}</p>

              <p class="mt-4 font-mono text-xs text-paper-muted/80">{d.stack.join(' · ')}</p>

              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                {d.repo && (
                  <a href={d.repo} class="text-paper-muted hover:text-paper-ink">
                    {t('work.source')}
                  </a>
                )}
                {d.live && d.liveStatus === 'up' && (
                  <a href={d.live} class="text-paper-muted hover:text-paper-ink">
                    {t('work.demo')}
                  </a>
                )}
                {d.liveStatus === 'down' && (
                  <span class="text-paper-muted/60">{t('work.offline')}</span>
                )}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</div>
